<Window x:Class="QScalp.Recorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QScalp Recorder" Width="520" Height="480"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Подключение" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="Сервер (WS):"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="tbServerUrl"
                         ToolTip="ws://127.0.0.1:9500/"/>

                <Label Grid.Row="1" Content="Каталог записи:"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="tbOutputDir"/>

                <Label Grid.Row="2" Content="Тикер:"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="tbTicker"
                         CharacterCasing="Upper" MaxLength="16"/>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,6">
            <Button x:Name="btnRecord" Content="●  Запись" Width="120" Height="32"
                    Click="BtnRecord_Click" FontWeight="SemiBold"/>
            <Button x:Name="btnStop" Content="■  Стоп" Width="120" Height="32"
                    Margin="10,0,0,0" Click="BtnStop_Click" IsEnabled="False"/>
            <CheckBox x:Name="cbSnapshots" Content="Снапшоты" VerticalAlignment="Center"
                      Margin="16,0,0,0" ToolTip="Также писать Snapshot в JSONL"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,6">
            <TextBlock x:Name="tbStatus" Text="Готов" FontWeight="SemiBold"/>
            <TextBlock x:Name="tbSessionPath" Text="" FontSize="11" Foreground="Gray"
                       TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>

        <GroupBox Grid.Row="3" Header="Лог" Padding="4">
            <TextBox x:Name="tbLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                     Background="#FF1E1E1E" Foreground="#FFDCDCDC" AcceptsReturn="True"/>
        </GroupBox>
    </Grid>
</Window>
