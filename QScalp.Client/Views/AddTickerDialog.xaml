<Window x:Class="QScalp.Client.Views.AddTickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:enums="clr-namespace:QScalp.Shared.Models;assembly=QScalp.Shared"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Добавить тикер"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <ObjectDataProvider x:Key="ClusterBaseValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:ClusterBase"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <StackPanel Margin="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Тикер" Margin="0,4,8,4"/>
            <TextBox  Grid.Row="0" Grid.Column="1" Margin="0,2"
                      Text="{Binding Ticker, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="1" Text="SecKey (опционально)" Margin="0,4,8,4"/>
            <TextBox  Grid.Row="1" Grid.Column="1" Margin="0,2"
                      Text="{Binding SecKey, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="2" Text="PriceStep (IntPrice units)" Margin="0,4,8,4"/>
            <TextBox  Grid.Row="2" Grid.Column="1" Margin="0,2"
                      Text="{Binding PriceStep, UpdateSourceTrigger=LostFocus}"/>

            <TextBlock Grid.Row="3" Text="ClusterBase" Margin="0,4,8,4"/>
            <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,2"
                      ItemsSource="{Binding Source={StaticResource ClusterBaseValues}}"
                      SelectedItem="{Binding ClusterBase}"/>

            <TextBlock Grid.Row="4" Text="ClusterSize" Margin="0,4,8,4"/>
            <TextBox  Grid.Row="4" Grid.Column="1" Margin="0,2"
                      Text="{Binding ClusterSize, UpdateSourceTrigger=LostFocus}"/>

            <TextBlock Grid.Row="5" Text="HistoryCapacity" Margin="0,4,8,4"/>
            <TextBox  Grid.Row="5" Grid.Column="1" Margin="0,2"
                      Text="{Binding HistoryCapacity, UpdateSourceTrigger=LostFocus}"/>

            <CheckBox Grid.Row="6" Grid.Column="1" Margin="0,8,0,0"
                      Content="Писать сигналы в CSV"
                      IsChecked="{Binding LogToCsv}"/>

            <CheckBox Grid.Row="7" Grid.Column="1" Margin="0,6,0,0"
                      Content="Сохранять кластеры в JSON"
                      IsChecked="{Binding ExportClustersToJson}"/>
        </Grid>

        <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" TextWrapping="Wrap">
            Подсказка: PriceStep задаётся в единицах IntPrice сервера (raw × 10^6). Для бумаги
            с шагом 0.01 это 10 000. ClusterSize — секунды для Time, объём для Volume и т.д.
            Экспорт кластеров: clusters\clusters_{тикер}.jsonl рядом с exe.
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Width="100" Margin="0,0,8,0" Click="OnCancel"/>
            <Button Content="OK"     Width="100" Click="OnOk"
                    Style="{StaticResource AccentButton}"
                    IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
